{
  "name": "@local/formatjiang-assistant",
  "version": "0.3.0",
  "private": true,
  "description": "格式匠论文助手：把本机格式匠的论文工具接进 DeepSeek Harness，负责发现、拉起、重连与状态说明。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "*"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "docs"
  ],
  "scripts": {
    "test": "node --import ./tests/hooks.mjs --test tests/host.test.mjs tests/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "formatjiang",
    "docx",
    "论文"
  ],
  "license": "MIT"
}

